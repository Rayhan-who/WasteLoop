# ---------------------------------------------------------------------------
# WasteLoop environment variables. Copy to .env.local and fill in real values.
# Never commit .env.local. On Vercel, set these under Project → Settings → Env.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API). The anon key is safe in the browser;
# Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Used exclusively by admin paths and cron handlers
# (src/lib/supabase/admin.ts, which imports "server-only"). Never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the deployment, used in auth e-mail redirects and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/*.
CRON_SECRET=generate-a-long-random-string

# Payments (FR-7.x). Only "mock" is implemented; see README → Payments.
PAYMENT_PROVIDER=mock

# Notification dispatch for e-mail / SMS. "console" logs instead of sending.
NOTIFICATION_DISPATCHER=console

# Nominatim geocoding (OpenStreetMap). Their usage policy requires an
# identifying User-Agent with a contact address for your deployment.
NOMINATIM_USER_AGENT=WasteLoop/0.1 (contact: ops@example.org)

# Deferred ML features (Phase 2). All default to false; see src/lib/ml/flags.ts.
ML_SUGGEST_CATEGORY=false
ML_ESTIMATE_QUANTITY=false
ML_FRESHNESS=false
ML_RECOMMENDATIONS=false
ML_FORECAST=false
ML_ROUTE_CLUSTERING=false
ML_COMPLETION_LIKELIHOOD=false
ML_PRICE_SUGGESTION=false
ML_ANOMALY_DETECTION=false
ML_CONTENT_SCREENING=false
